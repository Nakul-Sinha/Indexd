<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.farlands</groupId>
    <artifactId>farlands-plugin</artifactId>
    <version>1.0.0</version>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <!-- Paper API pin is the lifted 1.20.4 template. Bumping to 26.x is a reviewed migration. -->
    </properties>

    <repositories>
        <repository>
            <id>papermc-repo</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.20.4-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!--
            Both additions are test scope, so nothing new ships in the JAR. The
            telemetry emitter uses Gson and java.net.http, both already on the
            classpath (Gson arrives with paper-api), so there is nothing to shade
            and no way to collide with another plugin's JSON stack.
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.13.4</version>
            <scope>test</scope>
        </dependency>

        <!--
            3.85.0 specifically. MockBukkit publishes one release per Paper patch
            and this is the one built against 1.20.4; on 3.9.0, which targets
            1.20.1, ServerMock cannot even be constructed because 1.20.4 moved
            PotionEffectType behind a registry. Bump this in step with paper-api,
            not on its own.
        -->
        <dependency>
            <groupId>com.github.seeseemelk</groupId>
            <artifactId>MockBukkit-v1.20</artifactId>
            <version>3.85.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Pinned because the version Maven binds by default predates JUnit 5. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
                <configuration>
                    <!--
                        MockBukkit builds its plugin class loader with Byte Buddy,
                        whose reflective class injector is unavailable on Java 25
                        unless java.lang is opened. Tests only: nothing the plugin
                        ships needs it, and the emitter itself uses no reflection.
                    -->
                    <argLine>--add-opens java.base/java.lang=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>