# The repository-root apps/api service (`bun run dev:api` from krishang).
LIVE_API_URL=http://127.0.0.1:3001
# Required only when the browser-visible origin differs from the request origin.
CONTROL_PLANE_WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://user:password@host:26257/defaultdb?sslmode=verify-full
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Allay reads OPENAI_API_KEY only inside the repository-root apps/api service.
