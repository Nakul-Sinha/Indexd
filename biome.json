{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/.next",
      "!**/schemas/*.json",
      "!**/infra",
      "!**/plugin-runtime",
      "!**/packages/db/migrations",
      "!**/apps/api/backup-arch"
    ]
  },
  "overrides": [
    {
      "includes": ["apps/api/**", "packages/plugin-builder/**", "packages/db/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noImplicitAnyLet": "off",
            "noNonNullAssertedOptionalChain": "off",
            "noTemplateCurlyInString": "off"
          },
          "style": { "noNonNullAssertion": "off" },
          "complexity": {
            "noStaticOnlyClass": "off",
            "noThisInStatic": "off",
            "noArguments": "off"
          },
          "correctness": { "noUnusedImports": "off", "noUnreachable": "off" }
        }
      }
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "useConst": "error",
        "noNonNullAssertion": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
