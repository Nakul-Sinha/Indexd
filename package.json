{
  "name": "farlands-live",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.4.0",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "dev:api": "bun run --cwd apps/api dev",
    "test:api": "bun run --cwd apps/api test",
    "db:migrate": "bunx drizzle-kit migrate --config packages/db/drizzle.config.ts",
    "schemas": "bun run --cwd packages/contracts schemas",
    "schemas:check": "bun run --cwd packages/contracts schemas:check",
    "mock": "bun run --cwd tools/mock-api dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@types/bun": "^1.4.0",
    "turbo": "^2",
    "typescript": "^5"
  }
}
