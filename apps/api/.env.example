# Comma-separated, exact email addresses allowed to access /api/admin.
# Keep real addresses in an ignored .env.local file or deployment environment.
ADMIN_EMAIL_ALLOWLIST="admin@example.com"

# Copy to .env and fill values before running the backend
# Backend will read env vars at startup (via dotenv)

# Database — Cockroach Cloud (same cluster as the repo-root CONNECTION_STRING).
# Do not commit real credentials. Place them in an ignored .env.
DATABASE_URL="postgresql://user:pass@host:26257/defaultdb?sslmode=verify-full"

# Authentication
MOCK_USER_ID="" # Set to a valid user ID for local testing (bypasses Better Auth)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Blob runtime (optional)
BLOB_READ_WRITE_TOKEN=""
RUNTIME_JAR_BLOB_PATHNAME=""

# AWS / S3 for backups
AWS_REGION=""
S3_BUCKET=""
S3_PREFIX="infra-team"
# Optional backup-specific overrides. Empty values fall back to S3_BUCKET and
# S3_PREFIX respectively.
BACKUP_BUCKET=""
BACKUP_S3_PREFIX=""

# AWS credentials (for local testing only). Prefer IAM roles in production.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Farlands-specific AWS settings (used by infra tooling)
FARLANDS_AWS_ACCOUNT_ID=""
FARLANDS_EKS_ASSUME_ROLE=""
FARLANDS_EKS_ASSUME_ROLE_ARN=""

# Kubernetes / backup job settings
BACKUP_NAMESPACE="infra-team"
BACKUP_IMAGE_ARCHIVE="alpine:3.20"
BACKUP_IMAGE_UPLOAD="amazon/aws-cli:2.15.0"
BACKUP_SERVICE_ACCOUNT="backup-orchestrator"

# Notes:
# - Set `MOCK_USER_ID` to a user that owns the server you want to test. You can
#   find a valid user id from the database or create a test user in the app.
# - Start the backend with dotenv loaded (bun will load .env when using dotenv in code):
#
#   bun run --watch src/index.ts
#
# - Then trigger a manual backup:
#
#   curl -X POST "http://localhost:3001/api/servers/<serverId>/backups" \
#     -H "Content-Type: application/json" \
#     -d '{"name":"manual backup"}'
